// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String
  name           String?
  role           String         @default("USER") // USER | ADMIN
  disabled       Boolean        @default(false)
  assignedApiKey    String?
  resetCode      String?
  resetCodeExpires DateTime?
  emailVerifiedAt DateTime?
  emailVerifyToken String?
  emailVerifyExpires DateTime?
  tokenVersion   Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subscription   Subscription?
  tokenUsages    TokenUsage[]
  conversations  Conversation[]
  apiKeys        ApiKey[]
  upgradeRequests UpgradeRequest[]
  apiCreditLedger ApiCreditLedger[]
  cashoutRequests CashoutRequest[]
  planEntitlements PlanEntitlement[]
}

model ApiKey {
  id        String   @id @default(uuid())
  key       String   @unique
  encryptedKey String?
  name      String   @default("VS Code Key")
  providerScope String @default("all") // all legacy | codex | claude | grok
  quotaUsdMicros Int @default(0) // 0 = unlimited, monthly cap otherwise
  status    String   @default("active") // active | disabled
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Subscription {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              String   @default("starter") // starter | pro | developer
  billingInterval   String   @default("monthly") // weekly | monthly
  status            String   @default("inactive") // active | inactive | expired | cancelled | suspended
  expiryDate        DateTime
  apiAccessEnabled  Boolean  @default(false)
  customLimit5h     Int?
  customLimitWeekly Int?
  customLimitMonthly Int?
  apiCreditBalanceRp Int @default(0)
  apiCreditBalanceUsdMicros Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TokenUsage {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp        DateTime @default(now())
  modelUsed        String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  source           String   @default("web") // web | api
  apiKeyId         String?
  providerPool     String?
  fallbackUsed     Boolean  @default(false)
  packageId        String?

  @@index([userId, timestamp])
  @@index([modelUsed])
  @@index([packageId, timestamp])
}

model ApiCreditLedger {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String   // topup | usage | refund | adjustment
  amountRp         Int
  amountUsdMicros  Int      @default(0)
  fxRate           Int?
  modelUsed        String?
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  apiKeyId         String?
  providerPool     String?
  fallbackUsed     Boolean  @default(false)
  note             String?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("Percakapan Baru")
  shared    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // user | assistant
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model UpgradeRequest {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          String   // starter | pro | developer
  billingInterval String @default("monthly") // weekly | monthly
  paymentMethod String   // gopay | ovo | dana | bank | crypto
  paymentRef    String?  // user's payment reference / phone number
  paymentProof  String?  // base64 proof image
  uniqueCode    String?  // 3-digit unique transfer code
  transferAmount Int?    // exact amount user should transfer
  status        String   @default("pending") // pending | confirmed | completed | rejected
  note          String?
  adminActionBy String?
  adminActionAt DateTime?
  confirmedAt   DateTime?
  completedAt   DateTime?
  rejectedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([userId, status])
}

model CashoutRequest {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUsdMicros Int
  amountRp        Int
  feeRp           Int      @default(0)
  payoutAmountRp  Int      @default(0)
  fxRate          Int
  payoutMethod    String
  payoutRef       String?
  status          String   @default("pending") // pending | confirmed | completed | rejected
  reason          String?
  adminActionBy   String?
  adminActionAt   DateTime?
  confirmedAt     DateTime?
  completedAt     DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime @default(now())
}

model PlanEntitlement {
  id              String   @id @default(uuid())
  userId          String
  plan            String
  family          String
  billingInterval String
  status          String   @default("active")
  startsAt        DateTime
  expiresAt       DateTime
  activatedAt     DateTime?
  sourceRequestId String?
  limitUnits      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, family, startsAt, expiresAt])
  @@index([sourceRequestId])
}

model Setting {
  key   String @id
  value String
}
